{
  "manifest_version": 3,
  "name": "ChatGPT Completion Sound",
  "version": "0.2.2",
  "description": "Plays potion.wav and shows a silent notification when a ChatGPT tab finishes generating.",
  "permissions": ["storage", "offscreen", "notifications"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "ChatGPT Completion Sound",
    "default_popup": "popup.html"
  },
  "icons": { "128": "icon128.png" }
}
